---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../ui/PageHeader.astro';
import PostList from './PostList.astro';
import Pagination from './Pagination.astro';
import { langCodes, type Lang } from '../../i18n/languages';
import { localePath, useTranslations } from '../../i18n';
import { formatNumber } from '../../utils/formatDate';
import type { Post } from '../../utils/posts';

interface Props {
  lang: Lang;
  posts: Post[];
  current: number;
  total: number;
}
const { lang, posts, current, total } = Astro.props;
const t = useTranslations(lang);
const alternates = Object.fromEntries(langCodes.map((code) => [code, localePath(code, 'blog')]));
const suffix =
  current > 1
    ? ` (${t('pagination.page', { current: formatNumber(current, lang), total: formatNumber(total, lang) })})`
    : '';
---

<BaseLayout title={`${t('blog.title')}${suffix}`} description={t('blog.description')} alternates={alternates}>
  <PageHeader title={t('blog.title')} description={t('blog.description')} />
  <section class="section">
    <div class="container">
      <PostList posts={posts} lang={lang} />
      <Pagination lang={lang} current={current} total={total} />
    </div>
  </section>
</BaseLayout>

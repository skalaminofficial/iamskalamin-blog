---
import Tag from './Tag.astro';
import { SITE } from '../../config';
import { formatDate, formatNumber } from '../../utils/formatDate';
import { readingTime } from '../../utils/readingTime';
import { postPath, type Post } from '../../utils/posts';
import { useTranslations } from '../../i18n';
import type { Lang } from '../../i18n/languages';

interface Props {
  post: Post;
  lang: Lang;
}
const { post, lang } = Astro.props;
const t = useTranslations(lang);
const { title, description, pubDate, tags, cover, coverAlt } = post.data;
const minutes = formatNumber(readingTime(post.body), lang);
---

<article class="card post-card">
  <div class="thumb">
    {
      cover ? (
        <img src={cover} alt={coverAlt ?? ''} loading="lazy" decoding="async" />
      ) : (
        <div class="thumb-fallback" aria-hidden="true">{SITE.name[lang].charAt(0)}</div>
      )
    }
  </div>
  <div class="body">
    {
      tags.length > 0 && (
        <div class="tags">
          {tags.slice(0, 3).map((tag) => <Tag tag={tag} lang={lang} />)}
        </div>
      )
    }
    <h3 class="title"><a class="stretched" href={postPath(post)}>{title}</a></h3>
    <p class="desc">{description}</p>
    <p class="meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
      <span aria-hidden="true">·</span>
      <span>{t('blog.minRead', { n: minutes })}</span>
    </p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }
  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-muted);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }
  .post-card:hover .thumb img {
    transform: scale(1.04);
  }
  .thumb-fallback {
    height: 100%;
    display: grid;
    place-items: center;
    font-size: 4rem;
    font-weight: 800;
    color: var(--on-accent);
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-5);
  }
  .tags {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: var(--space-3);
  }
  .title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }
  .title a {
    color: var(--text);
  }
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .desc {
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin-bottom: var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    margin: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>

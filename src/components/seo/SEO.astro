---
import { SITE } from '../../config';
import { langCodes, defaultLang, type Lang } from '../../i18n/languages';
import { switchLangPath } from '../../i18n';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  modifiedDate?: Date;
  tags?: string[];
  noindex?: boolean;
  alternates?: Partial<Record<Lang, string>>;
}

const {
  title,
  description,
  lang,
  image,
  type = 'website',
  publishedDate,
  modifiedDate,
  tags = [],
  noindex = false,
  alternates,
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site).href;
const siteName = SITE.name[lang];
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const ogImage = new URL(image ?? '/og-default.png', site).href;
const ogLocales: Record<string, string> = { en: 'en_US', bn: 'bn_BD' };

// অন্য ভাষার সংস্করণ (hreflang)
const altPaths: Partial<Record<Lang, string>> =
  alternates ??
  Object.fromEntries(langCodes.map((code) => [code, switchLangPath(Astro.url, code)]));
const altLinks = Object.entries(altPaths).map(([code, path]) => ({
  code,
  href: new URL(path as string, site).href,
}));
const xDefault = altLinks.find((a) => a.code === defaultLang);

// Structured data
const author = {
  '@type': 'Person',
  name: SITE.author[lang],
  url: new URL(`/${lang}/about/`, site).href,
};
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImage,
        inLanguage: lang,
        mainEntityOfPage: canonical,
        datePublished: publishedDate?.toISOString(),
        dateModified: (modifiedDate ?? publishedDate)?.toISOString(),
        keywords: tags.join(', '),
        author,
        publisher: author,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        url: canonical,
        description,
        inLanguage: lang,
        author,
      };
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && altLinks.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
{!noindex && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocales[lang] ?? lang} />
{type === 'article' && publishedDate && (
  <meta property="article:published_time" content={publishedDate.toISOString()} />
)}
{type === 'article' && modifiedDate && (
  <meta property="article:modified_time" content={modifiedDate.toISOString()} />
)}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={jsonLdString} />

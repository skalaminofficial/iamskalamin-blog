---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langCodes, type Lang } from '../../i18n/languages';
import { formatDate } from '../../utils/formatDate';
import { useTranslations } from '../../i18n';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((entry) => {
    const [lang, ...rest] = entry.id.split('/');
    return { params: { lang, slug: rest.join('/') }, props: { entry } };
  });
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const t = useTranslations(lang);
const { Content } = await render(entry);
const { title, description, updatedDate } = entry.data;

// অন্য ভাষায় একই পেজ থাকলে তার লিংক
const pages = await getCollection('pages');
const alternates: Partial<Record<Lang, string>> = {};
for (const code of langCodes) {
  if (pages.some((p) => p.id === `${code}/${slug}`)) alternates[code] = `/${code}/${slug}/`;
}
---

<BaseLayout title={title} description={description} alternates={alternates}>
  <div class="container container--narrow page">
    <h1>{title}</h1>
    {updatedDate && (
      <p class="updated">{t('blog.updatedOn', { date: formatDate(updatedDate, lang) })}</p>
    )}
    <div class="prose">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-10) 0;
  }
  .updated {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
  }
</style>

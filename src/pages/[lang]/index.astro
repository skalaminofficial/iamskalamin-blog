---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/blog/PostList.astro';
import { SITE } from '../../config';
import { langCodes, type Lang } from '../../i18n/languages';
import { localePath, useTranslations } from '../../i18n';
import { formatNumber } from '../../utils/formatDate';
import { getPosts, getTags, tagLabel } from '../../utils/posts';

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const latest = (await getPosts(lang)).slice(0, 6);
const tags = await getTags(lang);
const heroPhoto = SITE.profile.hero;
---

<BaseLayout>
  <section class="hero">
    <div class:list={['container', 'hero-inner', !heroPhoto && 'no-photo']}>
      <div class="hero-text">
        <p class="eyebrow">{t('site.tagline')}</p>
        <h1>
          {t('hero.greeting')} <span class="gradient-text">{SITE.name[lang]}</span>
        </h1>
        <p class="role">{t('hero.role')}</p>
        <p class="intro">{t('hero.intro')}</p>
        <div class="cta">
          <a class="btn btn--primary" href={localePath(lang, 'blog')}>{t('hero.cta')}</a>
          <a class="btn btn--ghost" href={localePath(lang, 'about')}>{t('hero.about')}</a>
        </div>
      </div>

      {heroPhoto && (
        <figure class="portrait">
          <img
            src={heroPhoto}
            alt={SITE.profile.alt[lang]}
            width="1200"
            height="1600"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{t('home.latest')}</h2>
        <a href={localePath(lang, 'blog')}>{t('home.viewAll')} →</a>
      </div>
      <PostList posts={latest} lang={lang} />
    </div>
  </section>

  {tags.length > 0 && (
    <section class="section topics">
      <div class="container">
        <h2>{t('home.topics')}</h2>
        <div class="topic-grid">
          {tags.map(({ tag, count }) => (
            <a class="card topic" href={localePath(lang, `tags/${tag}`)}>
              <strong>{tagLabel(t, tag)}</strong>
              <span>{t('tags.count', { n: formatNumber(count, lang) })}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-12) var(--space-10);
    background: var(--glow);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-10);
  }
  .hero-inner.no-photo {
    grid-template-columns: minmax(0, 52rem);
  }
  .eyebrow {
    display: inline-block;
    margin-bottom: var(--space-4);
    padding: 0.3rem 1rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-full);
  }
  h1 {
    font-size: var(--text-hero);
    line-height: 1.1;
    margin-bottom: var(--space-3);
  }
  .role {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }
  .intro {
    max-width: 38rem;
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin-bottom: var(--space-6);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* বড় লম্বা পোর্ট্রেট কার্ড: পেছনে সরে থাকা রঙিন ফ্রেম */
  .portrait {
    position: relative;
    margin-inline-end: 18px;
    isolation: isolate;
    margin: 0;
    width: clamp(15rem, 33vw, 26rem);
    aspect-ratio: 3 / 4;
  }
  .portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: translate(18px, 18px);
    border-radius: 28px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
  }
  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    border-radius: 28px;
    border: 4px solid var(--bg);
    box-shadow: var(--shadow-lg);
    background: var(--surface-muted);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .section-head h2 {
    margin: 0;
  }
  .topics {
    padding-top: 0;
  }
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-4);
  }
  .topic {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-5);
    color: var(--text);
  }
  .topic:hover {
    color: var(--text);
  }
  .topic span {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .hero {
      padding-block: var(--space-8);
    }
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
    /* মোবাইলে ছবি লেখার উপরে, ছোট করে */
    .portrait {
      order: -1;
      margin-inline-end: 10px;
      width: 10.5rem;
    }
    .portrait::before {
      transform: translate(10px, 10px);
      border-radius: 22px;
    }
    .portrait img {
      border-radius: 22px;
    }
  }
</style>

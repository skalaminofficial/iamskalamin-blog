---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/blog/PostList.astro';
import { SITE } from '../../config';
import { langCodes, type Lang } from '../../i18n/languages';
import { localePath, useTranslations } from '../../i18n';
import { formatNumber } from '../../utils/formatDate';
import { getPosts, getTags, tagLabel } from '../../utils/posts';

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const latest = (await getPosts(lang)).slice(0, 6);
const tags = await getTags(lang);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">{t('site.tagline')}</p>
      <h1>
        {t('hero.greeting')} <span class="gradient-text">{SITE.name[lang]}</span>
      </h1>
      <p class="role">{t('hero.role')}</p>
      <p class="intro">{t('hero.intro')}</p>
      <div class="cta">
        <a class="btn btn--primary" href={localePath(lang, 'blog')}>{t('hero.cta')}</a>
        <a class="btn btn--ghost" href={localePath(lang, 'about')}>{t('hero.about')}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{t('home.latest')}</h2>
        <a href={localePath(lang, 'blog')}>{t('home.viewAll')} →</a>
      </div>
      <PostList posts={latest} lang={lang} />
    </div>
  </section>

  {tags.length > 0 && (
    <section class="section topics">
      <div class="container">
        <h2>{t('home.topics')}</h2>
        <div class="topic-grid">
          {tags.map(({ tag, count }) => (
            <a class="card topic" href={localePath(lang, `tags/${tag}`)}>
              <strong>{tagLabel(t, tag)}</strong>
              <span>{t('tags.count', { n: formatNumber(count, lang) })}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-12) var(--space-10);
    background: var(--glow);
  }
  .hero-inner {
    max-width: 52rem;
  }
  .eyebrow {
    display: inline-block;
    margin-bottom: var(--space-4);
    padding: 0.3rem 1rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-full);
  }
  h1 {
    font-size: var(--text-hero);
    line-height: 1.1;
    margin-bottom: var(--space-3);
  }
  .role {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }
  .intro {
    max-width: 38rem;
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin-bottom: var(--space-6);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .section-head h2 {
    margin: 0;
  }
  .topics {
    padding-top: 0;
  }
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-4);
  }
  .topic {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-5);
    color: var(--text);
  }
  .topic:hover {
    color: var(--text);
  }
  .topic span {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
